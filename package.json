{
  "name": "pharmacore",
  "version": "1.0.0",
  "description": "PharmaCore - Pharmacy ERP + POS system",
  "author": "PharmaCore",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"vite,electron\" -c \"cyan,magenta\" \"npm run vite:dev\" \"npm run electron:dev\"",
    "vite:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "build": "node scripts/write-runtime-config.mjs && vite build",
    "preview": "vite preview",
    "make": "node scripts/write-runtime-config.mjs && npm run build && electron-builder --win",
    "test": "node --test",
    "scan": "node scripts/scan-undefined-identifiers.mjs",
    "verify-setup": "node scripts/verify-setup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@babel/traverse": "^7.29.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.pharmacore.pos",
    "productName": "PharmaCore POS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
